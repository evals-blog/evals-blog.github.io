---
import '@/styles/app.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { t } from '@/i18n';
import { type Locale, localeTags, locales, switchLocalePath } from '@/utils/i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = '',
  locale,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
  noindex = false,
} = Astro.props;

const siteName = t(locale)('site.name');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

const alternates = locales.map((alt) => ({
  locale: alt,
  href: new URL(switchLocalePath(Astro.url.pathname, alt), Astro.site).href,
}));
---

<!doctype html>
<html lang={localeTags[locale]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={localeTags[alt.locale]} href={alt.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(Astro.url.pathname, 'vi'), Astro.site).href}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* A file rather than an inline script so a future CSP with 'self' keeps working. */}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
