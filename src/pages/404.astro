---
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

const tr = t('vi');
---

<BaseLayout title={`${tr('404.title')} — ${tr('site.name')}`} description={tr('404.text')} locale="vi" noindex>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-bold uppercase tracking-widest text-text-secondary">404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{tr('404.title')}</h1>
    <p class="mt-3 text-lg text-text-secondary">{tr('404.text')}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/vi/" class="font-semibold no-underline hover:underline">{tr('404.back')}</a>
      <a href="/en/" class="font-semibold no-underline hover:underline">Back to home (EN)</a>
    </div>
  </section>
</BaseLayout>
