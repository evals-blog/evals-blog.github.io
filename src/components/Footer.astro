---
import { t } from '@/i18n';
import { type Locale, localeNames, localePath, otherLocale, switchLocalePath } from '@/utils/i18n';
import { getSectionSlug, getSections } from '@/utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const sections = await getSections(locale);
const altLocale = otherLocale(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-bg-secondary">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="m-0 font-semibold text-text">{tr('site.name')}</p>
        <p class="mt-1 text-sm text-text-secondary">&copy; {year} Thuat Nguyen</p>
      </div>

      <nav aria-label={tr('nav.topics')}>
        <p class="m-0 text-xs font-semibold uppercase tracking-wide text-text-secondary">
          {tr('nav.topics')}
        </p>
        <ul class="m-0 mt-2 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
          {sections.map((section) => (
            <li>
              <a
                href={localePath(`/${getSectionSlug(section)}/`, locale)}
                class="text-sm text-text-secondary no-underline hover:text-accent"
              >
                {section.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="text-sm">
        <a
          href={switchLocalePath(Astro.url.pathname, altLocale)}
          hreflang={altLocale}
          class="text-text-secondary no-underline hover:text-accent"
        >
          {localeNames[altLocale]}
        </a>
        <p class="m-0 mt-2 text-xs text-text-secondary">
          <a
            href="https://astro.build"
            rel="noopener"
            class="text-text-secondary no-underline hover:text-accent"
          >
            {tr('footer.builtWith')}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
