---
import PostCard from '@/components/PostCard.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Locale } from '@/utils/i18n';
import { type Section, getPostSection, getPosts, getSectionSlug } from '@/utils/posts';
import { render } from 'astro:content';

interface Props {
  section: Section;
  locale: Locale;
}

const { section, locale } = Astro.props;
const tr = t(locale);

const slug = getSectionSlug(section);
const all = await getPosts(locale);
const posts = all.filter((post) => getPostSection(post) === slug);

const { Content } = await render(section);
---

<BaseLayout title={`${section.data.title} — ${tr('site.name')}`} description={section.data.description} locale={locale}>
  <header class="mx-auto max-w-3xl px-4 pb-8 pt-12 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{section.data.title}</h1>
    <p class="mt-3 text-lg leading-relaxed text-text-secondary">{section.data.description}</p>
  </header>

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="post-content prose max-w-none">
      <Content />
    </div>

    {
      posts.length > 0 && (
        <section class="mt-12" aria-labelledby="section-posts-heading">
          <h2 id="section-posts-heading" class="mb-4 text-2xl font-bold tracking-tight">
            {tr('section.posts')}
          </h2>
          <ul class="m-0 flex list-none flex-col gap-4 p-0">
            {posts.map((post) => (
              <li>
                <PostCard post={post} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
