---
import Tag from '@/components/Tag.astro';
import { t } from '@/i18n';
import { formatDate, isoDate } from '@/utils/format';
import type { Locale } from '@/utils/i18n';
import { type BlogPost, getPostHref, readingTime } from '@/utils/posts';

interface Props {
  post: BlogPost;
  locale: Locale;
  /** Cards on topic pages pass image={false} to keep the list dense. */
  image?: boolean;
}

const { post, locale, image = true } = Astro.props;
const tr = t(locale);
const href = getPostHref(post, locale);
const { minutes } = readingTime(post.body, post.data.readTime);
const cover = post.data.featuredImage;
const summary = post.data.summary ?? post.data.description;
---

<article
  class="group overflow-hidden rounded-xl border border-border bg-surface p-5 transition-shadow hover:shadow-md"
>
  <div class="flex gap-4">
    {image && cover && (
      <a href={href} class="hidden shrink-0 sm:block" tabindex="-1" aria-hidden="true">
        <img
          src={cover}
          alt=""
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
          class="h-24 w-24 rounded-lg border border-border object-cover"
        />
      </a>
    )}

    <div class="min-w-0">
      <time datetime={isoDate(post.data.date)} class="block text-xs text-text-secondary">
        {formatDate(post.data.date, locale)}
      </time>

      <h3 class="mt-1 text-lg font-bold leading-snug">
        <a href={href} class="text-text no-underline hover:text-accent">{post.data.title}</a>
      </h3>

      <p class="m-0 mt-1 text-sm leading-relaxed text-text-secondary">{summary}</p>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {post.data.tags.map((tag: string) => <Tag label={tag} />)}
        <span class="text-xs text-text-secondary">{minutes} {tr('post.readTime')}</span>
      </div>
    </div>
  </div>
</article>
